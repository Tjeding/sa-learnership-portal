        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    users {\n        bigint id PK\n        citext email \&quot;unique\&quot;\n        text password_hash\n        user_role role\n        boolean is_active\n        boolean is_verified\n        text verification_token\n        timestamptz verification_expires_at\n        text password_reset_token\n        timestamptz password_reset_expires_at\n        timestamptz last_login_at\n        timestamptz created_at\n        timestamptz updated_at\n    }\n\n    applicant_profiles {\n        bigint user_id PK, FK \&quot;references users.id\&quot;\n        text first_name\n        text last_name\n        varchar id_number \&quot;unique\&quot;\n        varchar phone\n        date date_of_birth\n        gender_type gender\n        text province\n        text town_city\n        text address_line\n        varchar postal_code\n        text cv_file_path\n        timestamptz cv_uploaded_at\n        text bio\n        boolean profile_completed\n        timestamptz created_at\n        timestamptz updated_at\n    }\n\n    provider_profiles {\n        bigint user_id PK, FK \&quot;references users.id\&quot;\n        text organization_name\n        provider_type provider_type\n        text registration_number\n        text seta_accreditation_number\n        int sector_id FK \&quot;references sectors.id\&quot;\n        text contact_person\n        varchar phone\n        text website\n        text address_line\n        text province\n        text town_city\n        boolean is_verified\n        bigint verified_by FK \&quot;references users.id\&quot;\n        timestamptz verified_at\n        timestamptz created_at\n        timestamptz updated_at\n    }\n\n    sectors {\n        int id PK\n        text name \&quot;unique\&quot;\n    }\n\n    nqf_levels {\n        smallint id PK\n        text level_name\n        text sub_framework\n        text typical_example\n        text source_url\n    }\n\n    qualification_types {\n        int id PK\n        text saqa_id \&quot;unique\&quot;\n        text title\n        smallint nqf_level_id FK \&quot;references nqf_levels.id\&quot;\n        text qualification_category\n        boolean is_active\n        text source_url\n        timestamptz created_at\n    }\n\n    admin_qualification_suggestions {\n        bigint id PK\n        bigint suggested_by FK \&quot;references users.id\&quot;\n        text proposed_title\n        smallint proposed_nqf_level_id FK \&quot;references nqf_levels.id\&quot;\n        text saqa_reference_url\n        text status\n        bigint reviewed_by FK \&quot;references users.id\&quot;\n        timestamptz reviewed_at\n        timestamptz created_at\n    }\n\n    skills {\n        int id PK\n        text name \&quot;unique\&quot;\n        text category\n        timestamptz created_at\n    }\n\n    applicant_qualifications {\n        bigint id PK\n        bigint applicant_id FK \&quot;references applicant_profiles.user_id\&quot;\n        int qualification_type_id FK \&quot;references qualification_types.id\&quot;\n        text institution_name\n        smallint year_completed\n        text certificate_file_path\n        boolean is_verified\n        timestamptz created_at\n    }\n\n    applicant_skills {\n        bigint applicant_id PK, FK \&quot;references applicant_profiles.user_id\&quot;\n        int skill_id PK, FK \&quot;references skills.id\&quot;\n        proficiency_level proficiency\n    }\n\n    opportunities {\n        bigint id PK\n        bigint provider_id FK \&quot;references provider_profiles.user_id\&quot;\n        text title\n        text description\n        opportunity_type opportunity_type\n        int sector_id FK \&quot;references sectors.id\&quot;\n        smallint min_nqf_level_id FK \&quot;references nqf_levels.id\&quot;\n        numeric stipend_amount\n        text stipend_period\n        text location\n        text province\n        int duration_months\n        int positions_available\n        date closing_date\n        opportunity_status status\n        text rejection_reason\n        bigint approved_by FK \&quot;references users.id\&quot;\n        timestamptz approved_at\n        timestamptz created_at\n        timestamptz updated_at\n    }\n\n    opportunity_requirements {\n        bigint id PK\n        bigint opportunity_id FK \&quot;references opportunities.id\&quot;\n        text requirement_text\n        smallint display_order\n    }\n\n    opportunity_skills {\n        bigint opportunity_id PK, FK \&quot;references opportunities.id\&quot;\n        int skill_id PK, FK \&quot;references skills.id\&quot;\n        boolean is_required\n    }\n\n    opportunity_qualifications {\n        bigint opportunity_id PK, FK \&quot;references opportunities.id\&quot;\n        int qualification_type_id PK, FK \&quot;references qualification_types.id\&quot;\n        boolean is_required\n    }\n\n    applications {\n        bigint id PK\n        bigint applicant_id FK \&quot;references applicant_profiles.user_id\&quot;\n        bigint opportunity_id FK \&quot;references opportunities.id\&quot;\n        application_status status\n        text cover_note\n        bigint reviewed_by FK \&quot;references users.id\&quot;\n        timestamptz applied_at\n        timestamptz updated_at\n    }\n\n    application_status_history {\n        bigint id PK\n        bigint application_id FK \&quot;references applications.id\&quot;\n        application_status status\n        bigint changed_by FK \&quot;references users.id\&quot;\n        text notes\n        timestamptz changed_at\n    }\n\n    notifications {\n        bigint id PK\n        bigint user_id FK \&quot;references users.id\&quot;\n        notification_type type\n        text title\n        text message\n        bigint related_application_id FK \&quot;references applications.id\&quot;\n        bigint related_opportunity_id FK \&quot;references opportunities.id\&quot;\n        boolean is_read\n        timestamptz read_at\n        boolean email_sent\n        timestamptz email_sent_at\n        timestamptz created_at\n    }\n\n    notification_preferences {\n        bigint user_id PK, FK \&quot;references users.id\&quot;\n        boolean email_enabled\n        boolean in_app_enabled\n        boolean new_match_alerts\n        boolean closing_reminders\n    }\n\n    audit_log {\n        bigint id PK\n        bigint user_id FK \&quot;references users.id\&quot;\n        text action\n        text entity_type\n        bigint entity_id\n        jsonb details\n        timestamptz created_at\n    }\n\n    saved_reports {\n        bigint id PK\n        bigint created_by FK \&quot;references users.id\&quot;\n        text report_name\n        jsonb filters\n        timestamptz created_at\n        timestamptz updated_at\n    }\n\n    users ||--|| applicant_profiles : \&quot;user_id\&quot;\n    users ||--|| provider_profiles : \&quot;user_id\&quot;\n    users ||--o{ admin_qualification_suggestions : \&quot;suggested_by\&quot;\n    users ||--o{ admin_qualification_suggestions : \&quot;reviewed_by\&quot;\n    provider_profiles }o--|| sectors : \&quot;sector_id\&quot;\n    provider_profiles }o--|| users : \&quot;verified_by\&quot;\n    qualification_types }o--|| nqf_levels : \&quot;nqf_level_id\&quot;\n    applicant_qualifications }o--|| applicant_profiles : \&quot;applicant_id\&quot;\n    applicant_qualifications }o--|| qualification_types : \&quot;qualification_type_id\&quot;\n    applicant_skills }o--|| applicant_profiles : \&quot;applicant_id\&quot;\n    applicant_skills }o--|| skills : \&quot;skill_id\&quot;\n    opportunities }o--|| provider_profiles : \&quot;provider_id\&quot;\n    opportunities }o--|| sectors : \&quot;sector_id\&quot;\n    opportunities }o--|| nqf_levels : \&quot;min_nqf_level_id\&quot;\n    opportunities }o--|| users : \&quot;approved_by\&quot;\n    opportunity_requirements }o--|| opportunities : \&quot;opportunity_id\&quot;\n    opportunity_skills }o--|| opportunities : \&quot;opportunity_id\&quot;\n    opportunity_skills }o--|| skills : \&quot;skill_id\&quot;\n    opportunity_qualifications }o--|| opportunities : \&quot;opportunity_id\&quot;\n    opportunity_qualifications }o--|| qualification_types : \&quot;qualification_type_id\&quot;\n    applications }o--|| applicant_profiles : \&quot;applicant_id\&quot;\n    applications }o--|| opportunities : \&quot;opportunity_id\&quot;\n    applications }o--|| users : \&quot;reviewed_by\&quot;\n    application_status_history }o--|| applications : \&quot;application_id\&quot;\n    application_status_history }o--|| users : \&quot;changed_by\&quot;\n    notifications }o--|| users : \&quot;user_id\&quot;\n    notifications }o--|| applications : \&quot;related_application_id\&quot;\n    notifications }o--|| opportunities : \&quot;related_opportunity_id\&quot;\n    notification_preferences ||--|| users : \&quot;user_id\&quot;\n    audit_log }o--|| users : \&quot;user_id\&quot;\n    saved_reports }o--|| users : \&quot;created_by\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="JHx_Cij55qsQbi6-EihA-1">
