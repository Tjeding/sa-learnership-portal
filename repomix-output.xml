<file path="frontend/src/pages/public/OpportunitiesPreview.jsx">
import { useMemo, useState } from "react";
import { Link } from "react-router-dom";
import PublicNav from "../../components/PublicNav";
import { Search, MapPin, Clock, Wallet, Lock } from "lucide-react";
import { opportunities, sectors } from "../../data/mockData";

export default function OpportunitiesPreview() {
  const [q, setQ] = useState("");
  const [type, setType] = useState("all");

  const results = useMemo(() => {
    return opportunities.filter((o) => o.status === "approved").filter((o) => {
      const matchesQ = !q || o.title.toLowerCase().includes(q.toLowerCase());
      const matchesType = type === "all" || o.type === type;
      return matchesQ && matchesType;
    });
  }, [q, type]);

  return (
    <div>
      <PublicNav />
      <div className="public-page section" style={{ paddingBottom: 0 }}>
        <div className="section-head">
          <span className="eyebrow">Open now</span>
          <h2>Browse opportunities</h2>
          <p>Create a free account to apply, save listings, and get matched by your skills and NQF level.</p>
        </div>
        <div className="card" style={{ marginBottom: "var(--sp-5)" }}>
          <div style={{ display: "flex", gap: 12, flexWrap: "wrap" }}>
            <div className="search-bar" style={{ flex: 2, minWidth: 220 }}>
              <Search size={16} color="var(--stone)" />
              <input placeholder="Search opportunities…" value={q} onChange={(e) => setQ(e.target.value)} />
            </div>
            <select className="input" style={{ maxWidth: 200 }} value={type} onChange={(e) => setType(e.target.value)}>
              <option value="all">All types</option>
              <option value="learnership">Learnership</option>
              <option value="internship">Internship</option>
              <option value="apprenticeship">Apprenticeship</option>
            </select>
          </div>
        </div>

        <div className="grid grid-3">
          {results.map((o) => (
            <div key={o.id} className="opp-card">
              <span className="badge badge-sun">{o.type}</span>
              <h4>{o.title}</h4>
              <p className="text-sm text-stone">{o.provider} · {o.sector}</p>
              <div className="opp-meta">
                <span><MapPin size={13} /> {o.location}</span>
                <span><Clock size={13} /> {o.duration} months</span>
                <span><Wallet size={13} /> R{o.stipend.toLocaleString()}/mo</span>
              </div>
              <Link to="/register" className="btn btn-outline btn-sm"><Lock size={13} /> Log in to apply</Link>
            </div>
          ))}
        </div>
      </div>
      <div className="section" />
    </div>
  );
}
</file>

<file path="frontend/src/styles/components.css">
/* =========================================================================
   Shared UI component styles
   ========================================================================= */

/* ---------- App shell ---------- */
.app-shell {
  display: grid;
  grid-template-columns: 260px 1fr;
  min-height: 100vh;
}

.main-col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.page {
  padding: var(--sp-6) var(--sp-7);
  max-width: 1360px;
  width: 100%;
}

@media (max-width: 960px) {
  .app-shell { grid-template-columns: 1fr; }
  .sidebar { display: none; }
  .page { padding: var(--sp-4); }
}

/* ---------- Sidebar ---------- */
.sidebar {
  background: var(--ink);
  color: #eef0ec;
  padding: var(--sp-5) 0;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100vh;
  border-right: 4px solid var(--role-color, var(--veld));
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: 0 var(--sp-5) var(--sp-5);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  margin-bottom: var(--sp-4);
}

.sidebar-brand-mark {
  width: 38px; height: 38px;
  border-radius: var(--r-md);
  background: var(--role-color, var(--veld));
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display);
  font-weight: 700;
  color: var(--ink);
  flex-shrink: 0;
}

.sidebar-brand-text .name { font-family: var(--font-display); font-size: 15px; font-weight: 600; line-height: 1.2; }
.sidebar-brand-text .sub { font-size: 11px; color: #a9b2ac; letter-spacing: 0.03em; text-transform: uppercase; }

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 0 var(--sp-3);
  flex: 1;
  overflow-y: auto;
}

.sidebar-section-label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #7f887f;
  padding: var(--sp-4) var(--sp-3) var(--sp-1);
}

.sidebar-link {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: 10px var(--sp-3);
  border-radius: var(--r-md);
  color: #ccd2cb;
  font-size: 14px;
  font-weight: 500;
  position: relative;
}

.sidebar-link svg { flex-shrink: 0; opacity: 0.85; }

.sidebar-link:hover { background: rgba(255,255,255,0.06); color: #fff; }

.sidebar-link.active {
  background: rgba(255,255,255,0.1);
  color: #fff;
}

.sidebar-link.active::before {
  content: "";
  position: absolute;
  left: -12px; top: 8px; bottom: 8px;
  width: 3px;
  background: var(--role-color, var(--veld));
  border-radius: var(--r-pill);
}

.sidebar-link .badge-count {
  margin-left: auto;
  background: var(--rust);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 1px 7px;
  border-radius: var(--r-pill);
}

.sidebar-footer {
  padding: var(--sp-3);
  border-top: 1px solid rgba(255,255,255,0.08);
  margin-top: var(--sp-3);
}

/* ---------- Topbar ---------- */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-4) var(--sp-7);
  background: var(--paper-raised);
  border-bottom: 1px solid var(--line);
  position: sticky;
  top: 0;
  z-index: 10;
}

.topbar-greeting .eyebrow {
  font-size: 12px;
  color: var(--stone);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.topbar-greeting h1 { font-size: 22px; margin-top: 2px; }

.topbar-actions { display: flex; align-items: center; gap: var(--sp-4); }

.icon-btn {
  width: 38px; height: 38px;
  border-radius: var(--r-pill);
  border: 1px solid var(--line);
  background: var(--paper-raised);
  display: flex; align-items: center; justify-content: center;
  position: relative;
  color: var(--ink-soft);
}
.icon-btn:hover { background: var(--paper); }

.icon-btn .dot {
  position: absolute; top: -3px; right: -3px;
  background: var(--rust); color: #fff;
  font-size: 10px; font-weight: 700;
  min-width: 16px; height: 16px; border-radius: var(--r-pill);
  display: flex; align-items: center; justify-content: center;
  border: 2px solid var(--paper-raised);
}

.user-chip { display: flex; align-items: center; gap: var(--sp-3); padding-left: var(--sp-3); border-left: 1px solid var(--line); }
.avatar {
  width: 38px; height: 38px; border-radius: var(--r-pill);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display); font-weight: 700; font-size: 13px;
  color: #fff; flex-shrink: 0;
}
.user-chip .who { font-size: 13px; font-weight: 600; line-height: 1.2; }
.user-chip .role { font-size: 11px; color: var(--stone); }

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: var(--sp-2);
  padding: 10px 18px;
  border-radius: var(--r-md);
  font-size: 14px; font-weight: 600;
  border: 1px solid transparent;
  transition: transform 0.08s ease, box-shadow 0.15s ease;
  white-space: nowrap;
}
.btn:active { transform: translateY(1px); }
.btn-primary { background: var(--veld); color: #fff; }
.btn-primary:hover { background: var(--veld-deep); }
.btn-gold { background: var(--sun); color: var(--ink); }
.btn-gold:hover { background: var(--sun-deep); color: #fff; }
.btn-outline { background: transparent; border-color: var(--line); color: var(--ink); }
.btn-outline:hover { border-color: var(--stone-light); background: var(--paper); }
.btn-ghost { background: transparent; color: var(--ink-soft); }
.btn-ghost:hover { background: var(--paper); }
.btn-danger { background: transparent; border-color: var(--rust); color: var(--rust); }
.btn-danger:hover { background: var(--rust-tint); }
.btn-sm { padding: 6px 12px; font-size: 13px; }
.btn-block { width: 100%; }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }

/* ---------- Cards ---------- */
.card {
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  padding: var(--sp-5);
}
.card-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: var(--sp-4);
}
.card-title { font-size: 15px; font-weight: 700; font-family: var(--font-display); }
.card-link { font-size: 13px; font-weight: 600; color: var(--veld); }
.card-link:hover { text-decoration: underline; }

/* ---------- Grids ---------- */
.grid { display: grid; gap: var(--sp-5); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-2-1 { grid-template-columns: 2fr 1fr; }
.grid-1-2 { grid-template-columns: 1fr 2fr; }
@media (max-width: 1180px) {
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .grid-3 { grid-template-columns: repeat(2, 1fr); }
  .grid-2-1, .grid-1-2 { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .grid-4, .grid-3, .grid-2 { grid-template-columns: 1fr; }
}

/* ---------- Stat cards ---------- */
.stat-card {
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  padding: var(--sp-5);
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}
.stat-top { display: flex; align-items: center; justify-content: space-between; }
.stat-icon {
  width: 36px; height: 36px; border-radius: var(--r-md);
  display: flex; align-items: center; justify-content: center;
}
.stat-label { font-size: 13px; color: var(--stone); font-weight: 500; }
.stat-value { font-family: var(--font-mono); font-size: 30px; font-weight: 600; line-height: 1; }
.stat-foot { font-size: 12px; color: var(--stone); }
.stat-foot.up { color: var(--veld); font-weight: 600; }

/* ---------- Badges / status pills ---------- */
.badge {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 10px;
  border-radius: var(--r-pill);
  font-size: 11.5px; font-weight: 700;
  letter-spacing: 0.01em;
  white-space: nowrap;
}
.badge-dot { width: 6px; height: 6px; border-radius: var(--r-pill); background: currentColor; }
.badge-veld { background: var(--veld-tint); color: var(--veld-deep); }
.badge-sun { background: var(--sun-tint); color: var(--sun-deep); }
.badge-teal { background: var(--teal-tint); color: var(--teal); }
.badge-rust { background: var(--rust-tint); color: var(--rust); }
.badge-stone { background: var(--line-soft); color: var(--stone); }

/* ---------- Tables ---------- */
.table-wrap { overflow-x: auto; }
table.data-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
.data-table th {
  text-align: left; font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--stone); font-weight: 600; padding: 10px 14px; border-bottom: 1px solid var(--line);
  white-space: nowrap;
}
.data-table td { padding: 14px; border-bottom: 1px solid var(--line-soft); vertical-align: middle; }
.data-table tr:last-child td { border-bottom: none; }
.data-table tbody tr:hover { background: var(--paper); }
.cell-primary { font-weight: 600; }
.cell-sub { font-size: 12px; color: var(--stone); margin-top: 2px; }

/* ---------- Forms ---------- */
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: var(--sp-4); }
.field label { font-size: 13px; font-weight: 600; color: var(--ink-soft); }
.field .hint { font-size: 12px; color: var(--stone); }
.input, select.input, textarea.input {
  border: 1px solid var(--line);
  background: var(--paper-raised);
  border-radius: var(--r-md);
  padding: 10px 12px;
  font-size: 14px;
  font-family: inherit;
  color: var(--ink);
  width: 100%;
}
.input:focus, select.input:focus, textarea.input:focus {
  outline: none; border-color: var(--veld); box-shadow: 0 0 0 3px var(--veld-tint);
}
textarea.input { resize: vertical; min-height: 90px; }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
@media (max-width: 640px) { .field-row { grid-template-columns: 1fr; } }

/* ---------- Progress ring ---------- */
.ring-wrap { position: relative; width: 84px; height: 84px; flex-shrink: 0; }
.ring-wrap svg { transform: rotate(-90deg); }
.ring-label {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-weight: 700; font-size: 17px;
}

/* ---------- Pathway / status tracker (signature element) ---------- */
.pathway {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding: var(--sp-2) 0;
}
.pathway::before {
  content: "";
  position: absolute;
  top: 15px; left: 5%; right: 5%;
  height: 2px;
  background-image: linear-gradient(to right, var(--line) 60%, transparent 0%);
  background-size: 10px 2px;
  background-repeat: repeat-x;
  z-index: 0;
}
.pathway-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  position: relative;
  z-index: 1;
  text-align: center;
}
.pathway-dot {
  width: 14px; height: 14px; border-radius: var(--r-pill);
  background: var(--paper-raised);
  border: 2px solid var(--line);
}
.pathway-step.done .pathway-dot { background: var(--veld); border-color: var(--veld); }
.pathway-step.current .pathway-dot { background: var(--sun); border-color: var(--sun-deep); box-shadow: 0 0 0 4px var(--sun-tint); }
.pathway-step.rejected .pathway-dot { background: var(--rust); border-color: var(--rust); }
.pathway-label { font-size: 12px; font-weight: 600; color: var(--stone); }
.pathway-step.done .pathway-label, .pathway-step.current .pathway-label { color: var(--ink); }
.pathway-sub { font-size: 11px; color: var(--stone-light); }

/* ---------- Donut legend ---------- */
.legend-row { display: flex; align-items: center; gap: 8px; font-size: 13px; padding: 5px 0; }
.legend-swatch { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }
.legend-val { margin-left: auto; font-family: var(--font-mono); font-weight: 600; }

/* ---------- Misc ---------- */
.divider { height: 1px; background: var(--line); border: none; margin: var(--sp-5) 0; }
.text-stone { color: var(--stone); }
.text-sm { font-size: 13px; }
.eyebrow {
  font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--veld);
}
.empty-state {
  text-align: center; padding: var(--sp-8) var(--sp-5); color: var(--stone);
}
.empty-state h3 { color: var(--ink); margin-bottom: var(--sp-2); }
.chip-row { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
.chip {
  padding: 6px 12px; border-radius: var(--r-pill); border: 1px solid var(--line);
  font-size: 12.5px; font-weight: 600; color: var(--ink-soft); background: var(--paper);
}
.list-plain { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-3); }
.tabs { display: flex; gap: var(--sp-2); border-bottom: 1px solid var(--line); margin-bottom: var(--sp-5); }
.tab {
  padding: 10px 4px; font-size: 14px; font-weight: 600; color: var(--stone);
  border-bottom: 2px solid transparent; margin-bottom: -1px;
}
.tab.active { color: var(--veld); border-color: var(--veld); }
.search-bar {
  display: flex; align-items: center; gap: 8px;
  border: 1px solid var(--line); border-radius: var(--r-md);
  padding: 9px 12px; background: var(--paper-raised); flex: 1;
}
.search-bar input { border: none; outline: none; background: transparent; font-size: 14px; width: 100%; font-family: inherit; }

/* ---------- Public site ---------- */
.public-nav {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--sp-4) var(--sp-7);
  position: sticky; top: 0; z-index: 20;
  background: rgba(245, 244, 239, 0.85);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--line);
}
.public-nav-brand { display: flex; align-items: center; gap: var(--sp-3); }
.public-nav-links { display: flex; gap: var(--sp-6); font-size: 14px; font-weight: 600; color: var(--ink-soft); }
.public-nav-links a:hover { color: var(--veld); }
.public-nav-cta { display: flex; align-items: center; gap: var(--sp-3); }
@media (max-width: 860px) { .public-nav-links { display: none; } }

.public-page { max-width: 1280px; margin: 0 auto; padding: 0 var(--sp-7); }
@media (max-width: 640px) { .public-page { padding: 0 var(--sp-4); } }

.hero {
  padding: var(--sp-8) 0 var(--sp-7);
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: var(--sp-7);
  align-items: center;
}
@media (max-width: 960px) { .hero { grid-template-columns: 1fr; padding-top: var(--sp-6); } }

.hero h1 {
  font-size: 52px;
  line-height: 1.04;
  letter-spacing: -0.02em;
}
@media (max-width: 640px) { .hero h1 { font-size: 34px; } }

.hero .lede { font-size: 17px; color: var(--ink-soft); max-width: 46ch; margin-top: var(--sp-4); line-height: 1.55; }
.hero-cta { display: flex; gap: var(--sp-3); margin-top: var(--sp-6); flex-wrap: wrap; }
.hero-stats { display: flex; gap: var(--sp-6); margin-top: var(--sp-7); }
.hero-stat .num { font-family: var(--font-mono); font-size: 26px; font-weight: 700; color: var(--veld-deep); }
.hero-stat .lbl { font-size: 12.5px; color: var(--stone); margin-top: 2px; }

.journey-card {
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  padding: var(--sp-6);
  box-shadow: var(--shadow-lg);
}

.section { padding: var(--sp-8) 0; }
.section-head { max-width: 640px; margin-bottom: var(--sp-6); }
.section-head .eyebrow { display: block; margin-bottom: var(--sp-2); }
.section-head h2 { font-size: 32px; }
.section-head p { color: var(--stone); margin-top: var(--sp-3); font-size: 15.5px; }

.role-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-5); }
@media (max-width: 860px) { .role-cards { grid-template-columns: 1fr; } }
.role-card {
  border: 1px solid var(--line); border-radius: var(--r-lg); padding: var(--sp-5);
  background: var(--paper-raised);
  display: flex; flex-direction: column; gap: var(--sp-3);
}
.role-card .mark {
  width: 44px; height: 44px; border-radius: var(--r-md);
  display: flex; align-items: center; justify-content: center;
}
.role-card h3 { font-size: 18px; }
.role-card p { color: var(--stone); font-size: 14px; line-height: 1.5; }

.opp-card {
  border: 1px solid var(--line); border-radius: var(--r-lg); padding: var(--sp-5);
  background: var(--paper-raised);
  display: flex; flex-direction: column; gap: var(--sp-3);
  transition: box-shadow 0.15s ease, transform 0.15s ease;
}
.opp-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.opp-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-3); }
.opp-card h4 { font-size: 16px; }
.opp-meta { display: flex; flex-wrap: wrap; gap: var(--sp-4); font-size: 12.5px; color: var(--stone); }
.opp-meta span { display: flex; align-items: center; gap: 5px; }

.footer {
  border-top: 1px solid var(--line);
  padding: var(--sp-7) 0 var(--sp-6);
  margin-top: var(--sp-7);
}
.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: var(--sp-6); }
@media (max-width: 780px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
.footer h5 { font-size: 13px; margin-bottom: var(--sp-3); }
.footer a, .footer-grid p { color: var(--stone); font-size: 13.5px; }
.footer-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
.footer-bottom { margin-top: var(--sp-6); padding-top: var(--sp-5); border-top: 1px solid var(--line); font-size: 12.5px; color: var(--stone-light); display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-2); }

/* ---------- Auth pages ---------- */
.auth-shell { min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr; }
@media (max-width: 900px) { .auth-shell { grid-template-columns: 1fr; } }
.auth-visual {
  background: var(--ink); color: #fff;
  padding: var(--sp-8);
  display: flex; flex-direction: column; justify-content: space-between;
  position: relative; overflow: hidden;
}
.auth-visual::after {
  content: ""; position: absolute; right: -80px; bottom: -80px;
  width: 300px; height: 300px; border-radius: 50%;
  background: radial-gradient(circle, rgba(225,167,48,0.25), transparent 70%);
}
@media (max-width: 900px) { .auth-visual { display: none; } }
.auth-form-col { display: flex; align-items: center; justify-content: center; padding: var(--sp-6); }
.auth-card { width: 100%; max-width: 420px; }
.role-select { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3); margin-bottom: var(--sp-5); }
.role-option {
  border: 1.5px solid var(--line); border-radius: var(--r-md); padding: var(--sp-4);
  text-align: center; cursor: pointer; font-size: 13.5px; font-weight: 600;
}
.role-option.selected { border-color: var(--veld); background: var(--veld-tint); color: var(--veld-deep); }
