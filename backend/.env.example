# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# --- Database (matches docker/docker-compose.yml postgres service) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=sa_learnership
DB_USERNAME=sa_learnership_user
DB_PASSWORD=changeme

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT (config scaffolding only - not wired to any endpoint yet) ---
# Generate a real secret with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-base64-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- File storage (CVs, profile images) ---
UPLOAD_DIR=./uploads
MAX_CV_SIZE_BYTES=5242880
MAX_IMAGE_SIZE_BYTES=2097152
